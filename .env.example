# Vert Air Drone Agent Environment Variables
# Copy to .env and customize

# Server mode: cloud, self_hosted, hybrid
ADOS_SERVER_MODE=cloud

# Self-hosted server URL (required if mode is self_hosted or hybrid)
ADOS_SERVER_URL=https://exciting-marten-867.convex.site
ADOS_MQTT_BROKER=mqtt.vertair.co
ADOS_MQTT_USERNAME=ados
ADOS_MQTT_PASSWORD=zyrjun-hozku2-ciJxec
ADOS_API_KEY=

# Convex endpoints
ADOS_CONVEX_SITE_URL=https://exciting-marten-867.convex.site
ADOS_CONVEX_CLOUD_URL=https://exciting-marten-867.convex.cloud

# Log level: debug, info, warning, error
ADOS_LOG_LEVEL=info

# OTA update channel: stable, beta, nightly
ADOS_UPDATE_CHANNEL=stable

# GitHub repo for OTA updates
ADOS_GITHUB_REPO=compile22x/VertAirDroneAgent
